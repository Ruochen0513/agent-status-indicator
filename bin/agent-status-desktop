#!/usr/bin/env python3
"""Launch the cross-platform floating desktop indicator."""

from __future__ import annotations

import sys
import os
from pathlib import Path


ROOT = Path(__file__).resolve().parent.parent
MODULE_DIRS = [
    ROOT / "desktop",
    Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share") / "agent-status-indicator/desktop",
    Path.home() / "Library" / "Application Support" / "agent-status-indicator" / "desktop",
    Path.home() / "AppData" / "Local" / "AgentStatusIndicator" / "desktop",
]
for module_dir in MODULE_DIRS:
    if (module_dir / "agent_status_desktop.py").exists():
        sys.path.insert(0, str(module_dir))
        break
else:
    raise SystemExit(
        "Desktop runtime is missing. Re-run ./install.sh or copy "
        "desktop/agent_status_desktop.py to ~/.local/share/agent-status-indicator/desktop/"
    )

from agent_status_desktop import main  # noqa: E402


if __name__ == "__main__":
    raise SystemExit(main())
