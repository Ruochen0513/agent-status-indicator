#!/usr/bin/python3
"""Run `codex exec --json` and mirror JSONL lifecycle events to agent-status."""

from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path


STATUS = Path(__file__).resolve().parent / "agent-status"


def status_command() -> list[str]:
    command = [str(STATUS)]
    if os.name == "nt":
        command.insert(0, sys.executable)
    return command


def update(state: str, message: str = "", session: str = "") -> None:
    sid = session or f"codex:exec:{os.getpid()}"
    subprocess.run([*status_command(), "update", "codex", state, message, "--session", sid], check=False)


def state_for_event(event: dict) -> tuple[str | None, str]:
    event_type = event.get("type")
    if event_type in {"thread.started", "turn.started"}:
        return "working", event_type
    if event_type == "turn.completed":
        return "idle", event_type
    if event_type in {"turn.failed", "error"}:
        return "error", str(event.get("message") or event_type)
    item = event.get("item")
    if isinstance(item, dict) and item.get("type") in {"command_execution", "tool_call"}:
        status = item.get("status")
        if status == "in_progress":
            return "working", item.get("type", "")
        if status == "failed":
            return "error", item.get("type", "")
    return None, ""


def main(argv: list[str]) -> int:
    cmd = ["codex", "exec", "--json", *argv]
    session = f"codex:exec:{os.getpid()}"
    update("working", "codex exec", session)
    try:
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=None, text=True)
    except OSError as exc:
        update("error", f"Unable to start codex: {exc}", session)
        print(str(exc), file=sys.stderr)
        return 127
    assert proc.stdout is not None
    terminal_error = False
    interrupted = False
    try:
        for line in proc.stdout:
            print(line, end="", flush=True)
            try:
                event = json.loads(line)
            except json.JSONDecodeError:
                continue
            if not isinstance(event, dict):
                continue
            if event.get("type") in {"turn.failed", "error"}:
                terminal_error = True
            elif event.get("type") == "turn.completed":
                terminal_error = False
            state, message = state_for_event(event)
            if state:
                update(state, message, session)
    except KeyboardInterrupt:
        interrupted = True
        proc.terminate()
    finally:
        if interrupted:
            try:
                proc.wait(timeout=3)
            except subprocess.TimeoutExpired:
                proc.kill()
        returncode = proc.wait()
        if interrupted:
            update("idle", "interrupted", session)
        elif returncode == 0 and not terminal_error:
            update("idle", "completed", session)
        else:
            update("error", "turn failed" if terminal_error else f"exit {returncode}", session)
    return 130 if interrupted else returncode


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
