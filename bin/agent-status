#!/usr/bin/python3
"""Small state daemon/CLI for Codex and Claude Code desktop status."""

from __future__ import annotations

import argparse
from contextlib import contextmanager
import json
import errno
import os
import socket
import subprocess
import shutil
import queue
import threading
import sys
import time
from pathlib import Path
from typing import Any

from agent_status_state import empty_state, normalize_state, timestamp, VALID_STATES


APP_NAME = "agent-status-indicator"
VALID_AGENTS = {"codex", "claude", "all"}
SOCKET_SUPPORTED = hasattr(socket, "AF_UNIX")
CLIENT_TIMEOUT_SECONDS = 0.5
MAX_REQUEST_BYTES = 65536
LOCK_TIMEOUT_SECONDS = 2


def xdg_cache_home() -> Path:
    if sys.platform == "win32":
        return Path(os.environ.get("LOCALAPPDATA", Path.home() / "AppData" / "Local"))
    if sys.platform == "darwin":
        return Path.home() / "Library" / "Caches"
    return Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache"))


def runtime_dir() -> Path:
    base = os.environ.get("XDG_RUNTIME_DIR")
    if base:
        return Path(base) / APP_NAME
    if sys.platform == "win32":
        return Path(os.environ.get("LOCALAPPDATA", Path.home() / "AppData" / "Local")) / APP_NAME / "runtime"
    return Path("/tmp") / f"{APP_NAME}-{os.getuid()}"


def state_path() -> Path:
    return xdg_cache_home() / APP_NAME / "state.json"


def socket_path() -> Path:
    return runtime_dir() / "agent-status.sock"


def lock_path() -> Path:
    return state_path().with_suffix(".lock")


def now() -> float:
    return time.time()


def load_state() -> dict[str, Any]:
    path = state_path()
    try:
        loaded = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return empty_state()
    except (OSError, ValueError) as exc:
        raise ValueError(f"Cannot read state {path}: {exc}") from exc
    if not isinstance(loaded, dict):
        raise ValueError(f"Invalid state object in {path}")
    return normalize_state(loaded)


@contextmanager
def state_lock():
    """OS advisory locks are released on process exit; never unlink a live lock."""
    path = lock_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(path, os.O_CREAT | os.O_RDWR, 0o600)
    deadline = time.monotonic() + LOCK_TIMEOUT_SECONDS
    acquired = False
    try:
        if os.name == "nt":
            import msvcrt
            if os.fstat(fd).st_size == 0:
                os.write(fd, b"0")
        else:
            import fcntl
        while not acquired:
            try:
                if os.name == "nt":
                    os.lseek(fd, 0, os.SEEK_SET)
                    msvcrt.locking(fd, msvcrt.LK_NBLCK, 1)
                else:
                    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                acquired = True
            except OSError as exc:
                if exc.errno not in {errno.EACCES, errno.EAGAIN, errno.EDEADLK}:
                    raise
                if time.monotonic() >= deadline:
                    raise TimeoutError(f"timed out waiting for state lock: {path}") from exc
                time.sleep(0.01)
        yield
    finally:
        if acquired:
            if os.name == "nt":
                os.lseek(fd, 0, os.SEEK_SET)
                msvcrt.locking(fd, msvcrt.LK_UNLCK, 1)
            else:
                fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


def _save_state_unlocked(state: dict[str, Any]) -> None:
    path = state_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    with os.fdopen(os.open(tmp, os.O_CREAT | os.O_TRUNC | os.O_WRONLY, 0o600), "w", encoding="utf-8") as stream:
        json.dump(normalize_state(state), stream, indent=2, sort_keys=True, allow_nan=False)
    tmp.replace(path)


def save_state(state: dict[str, Any]) -> None:
    with state_lock():
        _save_state_unlocked(state)


def default_session_id(agent: str) -> str:
    return f"{agent}:manual"


def apply_update(
    agent: str,
    state_name: str,
    message: str = "",
    session_id: str | None = None,
    event: str = "",
    turn_id: str = "",
    observed_at: float | None = None,
) -> dict[str, Any]:
    if agent not in VALID_AGENTS:
        raise ValueError(f"invalid agent: {agent}")
    if state_name not in VALID_STATES:
        raise ValueError(f"invalid state: {state_name}")

    with state_lock():
        try:
            state = load_state()
        except ValueError:
            # Recovery is explicit; normal updates must not erase unreadable data.
            if agent != "all" or state_name != "idle" or session_id:
                raise
            path = state_path()
            if path.exists():
                path.replace(path.with_name(f"state.corrupt-{time.time_ns()}.json"))
            state = empty_state()
        ts = now()
        targets = ("codex", "claude") if agent == "all" else (agent,)
        clear_all = not session_id and state_name == "idle"
        for target in targets:
            sid = session_id or default_session_id(target)
            sessions = state.setdefault("sessions", {}).setdefault(target, {})
            if clear_all:
                sessions.clear()
                continue
            observed = timestamp(observed_at, ts)
            previous = sessions.get(sid, {})
            if observed < previous.get("updated_at", 0):
                continue
            previous_turn = previous.get("turn_id", "")
            if turn_id and previous_turn and turn_id != previous_turn and event != "UserPromptSubmit":
                continue
            # Retain terminal events as tombstones against late tool updates.
            if (event and event not in {"UserPromptSubmit", "SessionStart"}
                    and previous.get("state") == "idle"
                    and previous.get("event") in {"Stop", "Interrupt", "SessionEnd"}
                    and turn_id and turn_id == previous_turn):
                continue
            sessions[sid] = {
                "state": state_name,
                "message": message,
                "updated_at": observed,
                "event": event,
                "turn_id": turn_id or (previous_turn if event != "SessionStart" else ""),
            }
        state["updated_at"] = ts
        state = normalize_state(state)
        _save_state_unlocked(state)
        return state


def command_update(args: argparse.Namespace) -> int:
    # All writers use the same locked atomic transaction. A daemon outage or slow
    # socket must never drop/reorder lifecycle events or delay the agent's hook.
    apply_update(args.agent, args.state, args.message or "", args.session or None, args.event or "", args.turn, args.observed_at)
    return 0


def command_get(args: argparse.Namespace) -> int:
    state = normalize_state(load_state())
    if args.agent:
        print(json.dumps(state["agents"][args.agent], sort_keys=True))
    else:
        print(json.dumps(state, sort_keys=True))
    return 0


def codex_hook_report(response: dict, configured_events: list[str]) -> dict[str, Any]:
    """Report runtime registration and trust, never infer readiness from JSON alone."""
    if "error" in response:
        return {"status": "unavailable", "error": response["error"]}
    entries = response.get("result", {}).get("data", [])
    errors = [error for entry in entries for error in entry.get("errors", [])]
    own_hooks = [hook for entry in entries for hook in entry.get("hooks", [])
                 if "agent-status-hook" in (hook.get("command") or "")]
    events = {hook["eventName"].lower() for hook in own_hooks}
    ready = all(hook.get("enabled") and hook.get("trustStatus") in {"trusted", "managed"} for hook in own_hooks)
    if errors:
        status = "configuration_error"
    elif not own_hooks:
        status = "not_registered"
    elif any(hook.get("trustStatus") not in {"trusted", "managed"} for hook in own_hooks):
        status = "needs_trust"
    elif not ready:
        status = "disabled"
    elif not {"userpromptsubmit", "stop"}.issubset(events):
        status = "missing_lifecycle_events"
    else:
        status = "ready"
    return {
        "status": status,
        "hooks": [{key: hook.get(key) for key in ("eventName", "enabled", "trustStatus", "sourcePath", "command")} for hook in own_hooks],
        "errors": errors,
        "configured_events_not_registered": [event for event in configured_events if event.lower() not in events],
        "action": "Review and trust agent-status-hook in Codex /hooks; restart existing sessions after config changes.",
        "scope": "Fresh local Codex configuration; existing chats may still need to reload it.",
    }


def check_codex_hooks(configured_events: list[str], timeout: float = 10) -> dict[str, Any]:
    executable = shutil.which("codex")
    if not executable:
        return {"status": "unavailable", "error": "codex command not found"}
    proc = subprocess.Popen([executable, "app-server", "--stdio"], stdin=subprocess.PIPE,
                            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, bufsize=1)
    replies: queue.Queue = queue.Queue()

    def read_replies():
        try:
            for line in proc.stdout:
                try:
                    replies.put(json.loads(line))
                except ValueError:
                    continue
        finally:
            replies.put(None)

    reader = threading.Thread(target=read_replies, daemon=True)
    reader.start()
    deadline = time.monotonic() + timeout

    def request(identifier, method, params):
        proc.stdin.write(json.dumps({"id": identifier, "method": method, "params": params}) + "\n")
        proc.stdin.flush()
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise TimeoutError("Codex hooks/list timed out")
            try:
                reply = replies.get(timeout=remaining)
            except queue.Empty as exc:
                raise TimeoutError("Codex hooks/list timed out") from exc
            if reply is None:
                raise OSError("Codex app-server exited before returning hook metadata")
            if isinstance(reply, dict) and reply.get("id") == identifier:
                return reply

    try:
        initialized = request(1, "initialize", {
            "clientInfo": {"name": "agent_status_diagnostics", "version": "1"},
            "capabilities": {"experimentalApi": True},
        })
        if "error" in initialized:
            return {"status": "unavailable", "error": initialized["error"]}
        proc.stdin.write('{"method":"initialized"}\n')
        proc.stdin.flush()
        return codex_hook_report(request(2, "hooks/list", {"cwds": [str(Path.cwd())]}), configured_events)
    except (OSError, TimeoutError) as exc:
        return {"status": "unavailable", "error": str(exc)}
    finally:
        if proc.poll() is None:
            proc.terminate()
        try:
            proc.wait(timeout=2)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait()
        reader.join(timeout=1)
        for stream in (proc.stdin, proc.stdout):
            try:
                stream.close()
            except OSError:
                pass


def command_doctor(args: argparse.Namespace) -> int:
    report: dict[str, Any] = {
        "state_path": str(state_path()),
        "state_exists": state_path().exists(),
        "session_policy": "lifecycle events; active states never expire with time",
        "daemon_required": False,
        "hook_command": shutil.which("agent-status-hook"),
        "hooks": {},
    }
    healthy = True
    try:
        state = load_state()
        report["state_readable"] = True
        report["agents"] = state["agents"]
        report["sessions"] = state["sessions"]
    except ValueError as exc:
        healthy = False
        report["state_readable"] = False
        report["state_error"] = str(exc)
    for agent, path in (
        ("codex", Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex") / "hooks.json"),
        ("claude", Path.home() / ".claude/settings.json"),
    ):
        item = {"path": str(path), "exists": path.exists(), "trust": "Review in the agent's /hooks menu"}
        if path.exists():
            try:
                config = json.loads(path.read_text(encoding="utf-8"))
                hooks = config.get("hooks", {})
                item["events"] = list(hooks) if isinstance(hooks, dict) else []
            except (OSError, ValueError, AttributeError) as exc:
                item["error"] = str(exc)
                healthy = False
        report["hooks"][agent] = item
    codex_item = report["hooks"]["codex"]
    codex_item["runtime"] = {"status": "not_checked", "action": "Run agent-status doctor --check-codex to verify registration and trust."}
    if args.check_codex:
        try:
            codex_item["runtime"] = check_codex_hooks(codex_item.get("events", []))
        except OSError as exc:
            codex_item["runtime"] = {"status": "unavailable", "error": str(exc)}
        healthy = healthy and codex_item["runtime"]["status"] == "ready"
    if sys.platform.startswith("linux"):
        uuid = "agent-status-indicator@Ruochen0513.github.io"
        data_home = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share")
        extension_root = data_home / "gnome-shell/extensions"
        legacy_uuid = "agent-status-indicator@yuhaozhang.github.io"
        if not (extension_root / uuid).exists() and (extension_root / legacy_uuid).exists():
            uuid = legacy_uuid
        extension = extension_root / uuid
        report["gnome_extension"] = {"uuid": uuid, "path": str(extension), "installed": (extension / "extension.js").exists()}
        executable = shutil.which("gnome-extensions")
        if executable:
            try:
                result = subprocess.run([executable, "info", uuid], capture_output=True, text=True, timeout=3)
                report["gnome_extension"]["info"] = (result.stdout + result.stderr).strip()
                report["gnome_extension"]["query_ok"] = result.returncode == 0
            except (OSError, subprocess.TimeoutExpired) as exc:
                report["gnome_extension"]["error"] = str(exc)
    print(json.dumps(report, indent=2, sort_keys=True))
    return 0 if healthy else 1


def handle_client(conn: socket.socket) -> None:
    with conn:
        conn.settimeout(CLIENT_TIMEOUT_SECONDS)
        try:
            data = b""
            deadline = time.monotonic() + CLIENT_TIMEOUT_SECONDS
            while b"\n" not in data:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise TimeoutError("request timed out")
                conn.settimeout(remaining)
                chunk = conn.recv(4096)
                if not chunk:
                    break
                data += chunk
                if len(data) > MAX_REQUEST_BYTES:
                    raise ValueError("request too large")
            payload = json.loads(data.decode("utf-8"))
            if payload.get("action") != "update":
                raise ValueError("unsupported action")
            apply_update(
                str(payload.get("agent", "")),
                str(payload.get("state", "")),
                str(payload.get("message", "")),
                str(payload.get("session") or "") or None,
                str(payload.get("event") or ""),
            )
            conn.sendall(b'{"ok":true}\n')
        except Exception as exc:  # Keep daemon alive for bad hook payloads.
            try:
                conn.sendall(json.dumps({"ok": False, "error": str(exc)}).encode("utf-8") + b"\n")
            except OSError:
                pass


def command_daemon(args: argparse.Namespace) -> int:
    if not SOCKET_SUPPORTED:
        print("The local socket daemon is unavailable on this platform; updates use the state file directly.", file=sys.stderr)
        return 1
    runtime_dir().mkdir(parents=True, exist_ok=True)
    path = socket_path()
    if path.exists():
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as probe:
                probe.settimeout(0.2)
                probe.connect(str(path))
            print(f"agent-status daemon already running on {path}", file=sys.stderr)
            return 1
        except OSError:
            path.unlink(missing_ok=True)

    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as server:
        server.bind(str(path))
        os.chmod(path, 0o600)
        server.listen(16)
        print(f"agent-status daemon listening on {path}", flush=True)
        while True:
            conn, _ = server.accept()
            handle_client(conn)


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Track Codex/Claude Code status for a desktop indicator.")
    sub = parser.add_subparsers(dest="command", required=True)

    doctor = sub.add_parser("doctor", help="Diagnose state, hook configuration and GNOME installation.")
    doctor.add_argument("--check-codex", action="store_true", help="Query local Codex registration and trust through hooks/list (no model request).")
    doctor.set_defaults(func=command_doctor)

    daemon = sub.add_parser("daemon", help="Run the local status socket daemon.")
    daemon.set_defaults(func=command_daemon)

    update = sub.add_parser("update", help="Update one agent state.")
    update.add_argument("agent", choices=sorted(VALID_AGENTS))
    update.add_argument("state", choices=sorted(VALID_STATES))
    update.add_argument("message", nargs="?", default="")
    update.add_argument("--session", default="", help="Stable per-thread/session identifier.")
    update.add_argument("--event", default="", help="Source event name for diagnostics.")
    update.add_argument("--turn", default="", help="Source turn id, when available.")
    update.add_argument("--observed-at", type=float, default=None, help=argparse.SUPPRESS)
    update.set_defaults(func=command_update)

    get = sub.add_parser("get", help="Print current state as JSON.")
    get.add_argument("agent", nargs="?", choices=sorted(VALID_AGENTS - {"all"}))
    get.set_defaults(func=command_get)
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv or sys.argv[1:])
    try:
        return int(args.func(args))
    except (OSError, ValueError, TimeoutError) as exc:
        print(f"agent-status: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
